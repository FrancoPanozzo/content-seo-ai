# Duplicate this file as .env for development, do not commit into history

# Get this from your Neon dashboard -> "Connection Details"
# Example format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_NEON_HOST/YOUR_DB_NAME?sslmode=require"

# --- AUTHENTICATION (Clerk) ---
# Get these from the Clerk dashboard -> "API Keys"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"

# Standard Clerk Next.js routing paths (usually you don't need to change these)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# --- LLM PROVIDER (OpenRouter via Vercel AI SDK) ---
# Get this from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"